{
  "name": "openplot-ai",
  "productName": "OpenPlot AI",
  "version": "1.0.0",
  "description": "OpenPlot AI — a local-first AI chat & story-writing studio by Mahakam Moonlight Studio, for Windows, Linux and macOS.",
  "main": "dist-electron/main.js",
  "author": "Mahakam Moonlight Studio",
  "license": "MIT",
  "homepage": "https://github.com/mahakammoonlightstudio-beep/OpenPlot-AI#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahakammoonlightstudio-beep/OpenPlot-AI.git"
  },
  "bugs": {
    "url": "https://github.com/mahakammoonlightstudio-beep/OpenPlot-AI/issues"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env INKWELL_DEV=1 electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "dist:win": "vite build && tsc -p tsconfig.electron.json && electron-builder --win",
    "dist:linux": "vite build && tsc -p tsconfig.electron.json && electron-builder --linux",
    "dist:mac": "vite build && tsc -p tsconfig.electron.json && electron-builder --mac"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.10.0",
    "marked": "^15.0.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.0",
    "zustand": "^5.0.1"
  },
  "build": {
    "appId": "co.mahakammoon.openplotai",
    "productName": "OpenPlot AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/*.png",
      "build/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist",
        "to": "sql"
      }
    ],
    "win": {
      "target": [
        "nsis",
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icons"
    },
    "mac": {
      "target": [
        "dmg",
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
            
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon-512.png"
    }
  }
}
